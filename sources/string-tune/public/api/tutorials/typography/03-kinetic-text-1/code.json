[data-skill-hub] .d-line-1 {\n  top: 0;\n}\n\nsection[data-skill-hub] .d-line-2 {\n  bottom: 0;\n}\n\nsection[data-skill-hub] .-w {\n  position: relative;\n}\n\nsection[data-skill-hub] .start,\nsection[data-skill-hub] .end {\n  position: relative;\n  z-index: 10;\n  display: flex;\n  width: 100%;\n  height: calc(var(--vh, 1vh) * 100);\n  align-items: center;\n  justify-content: center;\n}\n\nsection[data-skill-hub] .start {\n  margin-bottom: calc(var(--vh, 1vh) * -100);\n}\n\nsection[data-skill-hub] .start span,\nsection[data-skill-hub] .end span {\n  border-radius: var(--h3);\n  background-color: var(--c-red);\n  padding: var(--g-gap) calc(var(--g-gap) * 2);\n  text-align: center;\n}\n\nsection[data-skill-hub] .row {\n  position: relative;\n  width: 100%;\n  height: calc(var(--vh, 1svh) * 200);\n  margin-bottom: calc(var(--vh, 1svw) * -80);\n}\n\nsection[data-skill-hub] .row-4 {\n  margin-bottom: initial;\n}\n\nsection[data-skill-hub] .row > div {\n  position: sticky;\n  top: 0;\n  display: flex;\n  width: 100%;\n  justify-content: center;\n  align-items: flex-start;\n  translate: 0 calc(var(--vh, 1vh) * 40);\n}\n\nsection[data-skill-hub] .row > div > span {\n  display: inline-flex;\n  font-family: \"Climate Crisis\", sans-serif;\n  font-weight: 700;\n  line-height: 0.82;\n  text-transform: uppercase;\n  white-space: nowrap;\n  color: transparent;\n  transform: translateZ(0);\n}\n\n\nsection[data-skill-hub] .row > div > span .-s-char {\n  position: relative;\n  display: inline-flex;\n  justify-content: center;\n  align-items: flex-start;\n  overflow: visible;\n  transform: translateZ(0);\n  will-change: scale;\n  transform-origin: 50% 0%;\n  font-size: calc(var(--fit-font-size, 1) * 1px);\n\n  --char-step: calc(0.5 / (var(--char-global-total) + 1));\n  --char-begin: calc(0.5 + var(--char-index) * var(--char-step));\n  --char-local: calc((var(--progress, 0) - var(--char-begin)) / var(--char-step));\n  --char-t: min(1, max(0, var(--char-local)));\n  scale: 1 calc(1 - var(--char-t));\n}\n\nsection[data-skill-hub] .row > div > span .-s-char::after {\n  content: attr(data-split-content);\n  position: absolute;\n  line-height: inherit;\n\n  translate: 0 -6.25%;\n  transform: translateZ(0);\n  will-change: scale, opacity;\n  transform-origin: 50% 99.5%;\n  color: #f4c7a7;\n\n  font-size: calc( var(--fit-font-size, 1) * 1px * (var(--fit-scale-y) * 0.2) );\n\n\n  --after-char-step: calc( 0.5 / var(--char-global-total) );\n  --after-char-begin: calc( var(--char-index) * var(--after-char-step) );\n  --after-char-local: calc( (var(--progress, 0) - var(--after-char-begin)) / var(--after-char-step) );\n  --after-char-t: min(1, max(0, var(--after-char-local)));\n\n  scale:\n    calc( 1 / (var(--fit-scale-y) * 0.2) )\n    min(var(--after-char-t), 0.9375);\n  ;\n  opacity: calc( var(--after-char-t) * 2 - var(--char-t) * 2 );\n}\n\nsection[data-skill-hub] .sun,\nsection[data-skill-hub] .balloon,\nsection[data-skill-hub] .cloud,\nsection[data-skill-hub] .fly {\n  position: absolute;\n  z-index: 20;\n  width: 40%;\n  pointer-events: none;\n}\n\nsection[data-skill-hub] .sun > div > svg,\nsection[data-skill-hub] .balloon > div > svg,\nsection[data-skill-hub] .cloud > div > svg,\nsection[data-skill-hub] .fly > div > svg {\n  aspect-ratio: 1 / 1;\n  transform-origin: 50% 100%;\n}\n\nsection[data-skill-hub] .sun {\n  top: calc(var(--vh, 1vg) * 50);\n  left: 5%;\n}\n\nsection[data-skill-hub] .sun > div {\n  transform-origin: -50% 100%;\n  scale: calc(0.5 + var(--progress));\n}\n\nsection[data-skill-hub] .sun > div > svg {\n  animation: cartoon-bounce 1.2s infinite ease-in-out;\n}\n\nsection[data-skill-hub] .balloon {\n  top: 20%;\n  left: 60%;\n}\n\nsection[data-skill-hub] .balloon > div {\n  transform-origin: 150% 100%;\n  scale: calc(0.5 + var(--progress));\n}\n\nsection[data-skill-hub] .balloon > div > svg {\n  animation: cartoon-bounce 1.5s infinite ease-in-out;\n}\n\nsection[data-skill-hub] .cloud {\n  top: 30%;\n  left: 30%;\n  width: 40%;\n}\n\nsection[data-skill-hub] .cloud > div {\n  transform-origin: -50% 100%;\n  scale: calc(0.5 + var(--progress));\n}\n\nsection[data-skill-hub] .cloud > div > svg {\n  animation: cartoon-bounce 1.05s infinite ease-in-out;\n}\n\nsection[data-skill-hub] .fly {\n  top: 60%;\n  left: 40%;\n}\n\nsection[data-skill-hub] .fly > div {\n  transform-origin: 50% -100%;\n  translate: calc(-50% + 100% * var(--progress));\n  rotate: calc(30deg - 45deg * var(--progress));\n}\n\nsection[data-skill-hub] .fly > div > svg {\n  animation: cartoon-bounce 1.35s infinite ease-in-out;\n}\n\n@keyframes cartoon-bounce {\n  0% {\n    transform: skewX(0deg);\n    scale: 1 1;\n  }\n\n  25% {\n    scale: 1 0.95;\n  }\n\n  50% {\n    transform: skewX(2deg);\n    scale: 1 1;\n  }\n\n  75% {\n    scale: 1 0.95;\n  }\n\n  100% {\n    transform: skewX(0deg);\n    scale: 1 1;\n  }\n}\n\n@media (min-width: 1024px) {\n  section[data-skill-hub] .row {\n    height: calc(var(--vw, 1vw) * 200);\n    margin-bottom: calc(var(--vw, 1vw) * -90);\n  }\n\n  section[data-skill-hub] .row-4 {\n    margin-bottom: initial;\n  }\n\n  section[data-skill-hub] .row > div {\n    translate: 0 var(--h5);\n  }\n  section[data-skill-hub] .row > div > span .-s-char {}\n  section[data-skill-hub] .row > div > span .-s-char::after {\n    font-size: calc( var(--fit-font-size, 1) * 1px * (var(--fit-scale-y) * 0.9) );\n\n    scale:\n      calc( 1 / (var(--fit-scale-y) * 0.9) )\n      min(var(--after-char-t), 0.9375);\n    ;\n  }\n\n  section[data-skill-hub] .sun,\n  section[data-skill-hub] .balloon,\n  section[data-skill-hub] .cloud,\n  section[data-skill-hub] .fly {\n    width: 25%;\n  }\n}"},"scripts":{"tutorial":""}}