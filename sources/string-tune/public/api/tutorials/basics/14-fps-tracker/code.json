{"content":"<div class=\"-w\">\n  <div class=\"grid\">\n    <figure class=\"image-1\">\n      <img string=\"lazy\" string-lazy=\"/string-tune/images/tutorials/basics/14/image-1.webp\" alt=\"StringTune\">\n    </figure>\n    <figure class=\"image-2\">\n      <img string=\"lazy\" string-lazy=\"/string-tune/images/tutorials/basics/14/image-2.webp\" alt=\"StringTune\">\n    </figure>\n    <figure class=\"image-3\">\n      <img string=\"lazy\" string-lazy=\"/string-tune/images/tutorials/basics/14/image-3.webp\" alt=\"StringTune\">\n    </figure>\n    <figure class=\"image-4\">\n      <img string=\"lazy\" string-lazy=\"/string-tune/images/tutorials/basics/14/image-4.webp\" alt=\"StringTune\">\n    </figure>\n    <figure class=\"image-5\">\n      <img string=\"lazy\" string-lazy=\"/string-tune/images/tutorials/basics/14/image-5.webp\" alt=\"StringTune\">\n    </figure>\n    <figure class=\"image-6\">\n      <img string=\"lazy\" string-lazy=\"/string-tune/images/tutorials/basics/14/image-6.webp\" alt=\"StringTune\">\n    </figure>\n    <figure class=\"image-7\">\n      <img string=\"lazy\" string-lazy=\"/string-tune/images/tutorials/basics/14/image-7.webp\" alt=\"StringTune\">\n    </figure>\n    <figure class=\"image-8\">\n      <img string=\"lazy\" string-lazy=\"/string-tune/images/tutorials/basics/14/image-8.webp\" alt=\"StringTune\">\n    </figure>\n    <figure class=\"image-9\">\n      <img string=\"lazy\" string-lazy=\"/string-tune/images/tutorials/basics/14/image-9.webp\" alt=\"StringTune\">\n    </figure>\n    <figure class=\"image-10\">\n      <img string=\"lazy\" string-lazy=\"/string-tune/images/tutorials/basics/14/image-10.webp\" alt=\"StringTune\">\n    </figure>\n    <figure class=\"image-11\">\n      <img string=\"lazy\" string-lazy=\"/string-tune/images/tutorials/basics/14/image-11.webp\" alt=\"StringTune\">\n    </figure>\n    <figure class=\"image-12\">\n      <img string=\"lazy\" string-lazy=\"/string-tune/images/tutorials/basics/14/image-12.webp\" alt=\"StringTune\">\n    </figure>\n    <figure class=\"image-13\">\n      <img string=\"lazy\" string-lazy=\"/string-tune/images/tutorials/basics/14/image-13.webp\" alt=\"StringTune\">\n    </figure>\n    <figure class=\"image-14\">\n      <img string=\"lazy\" string-lazy=\"/string-tune/images/tutorials/basics/14/image-14.webp\" alt=\"StringTune\">\n    </figure>\n    <figure class=\"image-15\">\n      <img string=\"lazy\" string-lazy=\"/string-tune/images/tutorials/basics/14/image-15.webp\" alt=\"StringTune\">\n    </figure>\n    <figure class=\"image-15\">\n      <img string=\"lazy\" string-lazy=\"/string-tune/images/tutorials/basics/14/image-16.webp\" alt=\"StringTune\">\n    </figure>\n  </div>\n</div>","styles":{"tutorial":"div[data-fps] {\n  background-color: var(--c-red) !important;\n  border: none !important;\n  top: calc(var(--vh,1vh) * 50) !important;\n  left: 50% !important;\n  right: auto !important;\n  bottom: auto !important;\n  z-index: 40 !important;\n  translate: -50% 0 !important;\n}\n\nsection[data-skill-hub] .-w {\n  display: grid;\n  grid-template-columns: repeat(14, 1fr);\n  column-gap: var(--g-gap);\n}\nsection[data-skill-hub] .grid {\n  grid-column-start: 1;\n  grid-column-end: 15;\n\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  column-gap: var(--g-gap);\n  row-gap: var(--g-gap);\n\n  margin-top: calc(var(--vh,1vh) * 50);\n  margin-bottom: calc(var(--vh,1vh) * 50);\n}\n\n@media (min-width: 1024px) {\n  section[data-skill-hub] .grid {\n    grid-column-start: 4;\n    grid-column-end: 12;\n\n    grid-template-columns: repeat(4, 1fr);\n  }\n  section[data-skill-hub] figure img {\n    filter: saturate(100%) contrast(100%);\n    transition: filter 1.5s var(--easing-function-2);\n  }\n  section[data-skill-hub] figure:hover img {\n    filter: saturate(0%) contrast(50%);\n    transition: filter 0s var(--easing-function-2);\n  }\n}"},"scripts":{"tutorial":"document.addEventListener('DOMContentLoaded', () => {\n  const stringTune = window.StringTuneContext;\n  stringTune.FPSTrackerVisible = true;\n});\n"}}